generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CatalogProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum CatalogSyncStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

model Shop {
  id     String @id @default(cuid()) @db.VarChar(30)
  domain String @unique @db.VarChar(255)

  catalogSyncId          String?           @db.VarChar(36)
  catalogSyncStatus      CatalogSyncStatus @default(IDLE)
  catalogSyncPage        Int               @default(0)
  catalogSyncedCount     Int               @default(0)
  catalogSyncError       String?           @db.Text
  catalogSyncStartedAt   DateTime?
  catalogSyncHeartbeatAt DateTime?
  catalogSyncFinishedAt  DateTime?

  products            CatalogProduct[]
  mediaAssets         MediaAsset[]
  watermarkJobs       WatermarkJob[]
  watermarkBatches    WatermarkBatch[]
  watermarkDesigns    WatermarkDesign[]
  publishedMedia      PublishedMedia[]
  webhookInbox        WebhookInbox[]
  publicationAttempts PublicationAttempt[]
  watermarkTemplates  WatermarkTemplate[]
  autoWatermarkRules  AutoWatermarkRule[]
  uninstalledAt       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("shops")
}

model CatalogProduct {
  id               String               @id @default(cuid()) @db.VarChar(30)
  shopId           String               @db.VarChar(30)
  shopifyProductId String               @db.VarChar(255)
  title            String               @db.VarChar(255)
  status           CatalogProductStatus
  productType      String               @default("") @db.VarChar(255)
  imageUrl         String?              @db.Text
  originalImageUrl String?              @db.Text
  imageAltText     String?              @db.Text

  sourceVersion     Int       @default(1)
  sourceMediaId     String?   @db.VarChar(255)
  sourceContentHash String?   @db.Char(64)
  needsReview       Boolean   @default(false)
  deletedAt         DateTime?

  /// Job auto-watermark gần nhất đã tạo cho sản phẩm: rule, design và phiên bản
  /// ảnh nguồn. Trùng cả ba thì rule không tạo job lặp lại.
  autoRuleId        String? @db.VarChar(36)
  autoDesignId      String? @db.VarChar(36)
  autoSourceVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  watermarkJobs WatermarkJob[]

  @@unique([shopId, shopifyProductId])
  @@index([shopId, deletedAt])
  @@index([shopId, productType])
  @@map("catalog_products")
}

enum MediaAssetKind {
  SOURCE
  PROCESSED
}

model MediaAsset {
  id          String         @id @db.VarChar(36)
  shopId      String         @db.VarChar(30)
  kind        MediaAssetKind
  storageKey  String         @unique @db.VarChar(500)
  sourceUrl   String?        @db.Text
  mimeType    String         @db.VarChar(100)
  contentHash String         @db.Char(64)
  byteSize    Int
  createdAt   DateTime       @default(now())

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  resultForJobs WatermarkJob[] @relation("WatermarkResult")

  @@index([shopId, createdAt])
  @@index([shopId, contentHash])
  @@map("media_assets")
}

enum WatermarkJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model WatermarkJob {
  id                String             @id @db.VarChar(36)
  shopId            String             @db.VarChar(30)
  catalogProductId  String             @db.VarChar(30)
  batchId           String?            @db.VarChar(36)
  sourceImageUrl    String             @db.Text
  designId          String             @db.VarChar(36)
  /// Rule đã tạo job này (null = merchant tạo tay).
  ruleId            String?            @db.VarChar(36)
  /// Xong thì tự đưa lên Shopify (rule bật autoPublish).
  publishOnComplete Boolean            @default(false)
  status            WatermarkJobStatus @default(PENDING)
  /// Thời điểm job batch được đưa vào BullMQ; null = còn chờ DispatchWatermarkBatch.
  enqueuedAt        DateTime?
  resultMediaId     String?            @db.VarChar(36)
  errorMessage      String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product             CatalogProduct       @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  design              WatermarkDesign      @relation(fields: [designId], references: [id], onDelete: Restrict)
  rule                AutoWatermarkRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  resultMedia         MediaAsset?          @relation("WatermarkResult", fields: [resultMediaId], references: [id], onDelete: SetNull)
  publishedMedia      PublishedMedia?
  publicationAttempts PublicationAttempt[]
  batch               WatermarkBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([batchId, status, enqueuedAt])
  @@map("watermark_jobs")
}

/// Thiết kế watermark nhiều lớp, bất biến. Trùng nội dung trong cùng shop thì dùng lại.
model WatermarkDesign {
  id          String   @id @db.VarChar(36)
  shopId      String   @db.VarChar(30)
  contentHash String   @db.Char(64)
  /// JSON `{ version: 2, layers: [...] }`, xem WatermarkDesign.toJSON().
  layers      String   @db.LongText
  createdAt   DateTime @default(now())

  shop    Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  jobs    WatermarkJob[]
  batches WatermarkBatch[]
  rules   AutoWatermarkRule[]

  @@unique([shopId, contentHash])
  @@map("watermark_designs")
}

enum AutoWatermarkScope {
  ALL
  COLLECTION
  PRODUCT_TYPE
}

/// Rule tự đóng watermark: sản phẩm thuộc phạm vi (cả shop, một collection hoặc
/// một product type) được đóng dấu bằng design của rule.
model AutoWatermarkRule {
  id               String             @id @db.VarChar(36)
  shopId           String             @db.VarChar(30)
  name             String             @db.VarChar(255)
  enabled          Boolean            @default(true)
  /// Số lớn hơn thắng khi một sản phẩm khớp nhiều rule.
  priority         Int                @default(0)
  scope            AutoWatermarkScope
  /// GID collection hoặc product type; null khi scope = ALL.
  scopeValue       String?            @db.VarChar(255)
  /// Tên hiển thị của collection (chụp lại lúc tạo rule).
  scopeLabel       String?            @db.VarChar(255)
  designId         String             @db.VarChar(36)
  onNewProduct     Boolean            @default(true)
  onPrimaryChanged Boolean            @default(false)
  /// Áp cho cả sản phẩm đang có trong phạm vi, kiểm tra lại hằng đêm.
  syncScope        Boolean            @default(false)
  autoPublish      Boolean            @default(false)
  lastAppliedAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  shop   Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  design WatermarkDesign @relation(fields: [designId], references: [id], onDelete: Restrict)
  jobs   WatermarkJob[]

  @@index([shopId, enabled])
  @@map("auto_watermark_rules")
}

model WatermarkBatch {
  id        String   @id @db.VarChar(36)
  shopId    String   @db.VarChar(30)
  designId  String?  @db.VarChar(36)
  totalJobs Int
  createdAt DateTime @default(now())

  shop   Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  design WatermarkDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)
  jobs   WatermarkJob[]

  @@index([shopId, createdAt])
  @@map("watermark_batches")
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BackgroundJob {
  id               String              @id @db.VarChar(36)
  jobType          String              @db.VarChar(50)
  payload          String              @db.Text
  payloadVersion   Int                 @default(1)
  processorVersion Int                 @default(1)
  status           BackgroundJobStatus @default(PENDING)
  attempts         Int                 @default(0)
  maxAttempts      Int                 @default(3)
  lastError        String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("background_jobs")
}

enum WebhookInboxStatus {
  RECEIVED
  ENQUEUED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model WebhookInbox {
  id           String             @id @db.VarChar(36)
  webhookId    String             @unique @db.VarChar(255)
  eventId      String?            @db.VarChar(255)
  shopId       String             @db.VarChar(30)
  topic        String             @db.VarChar(100)
  apiVersion   String             @db.VarChar(20)
  triggeredAt  DateTime
  productId    String             @db.VarChar(255)
  payload      String             @db.LongText
  status       WebhookInboxStatus @default(RECEIVED)
  processedAt  DateTime?
  errorMessage String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, productId, triggeredAt])
  @@index([status, createdAt])
  @@map("webhook_inbox")
}

enum PublicationAttemptStatus {
  PUBLISHING
  PUBLISHED
  FAILED
}

model PublicationAttempt {
  id             String                   @id @db.VarChar(36)
  shopId         String                   @db.VarChar(30)
  productId      String                   @db.VarChar(255)
  watermarkJobId String                   @db.VarChar(36)
  shopifyMediaId String?                  @db.VarChar(255)
  status         PublicationAttemptStatus @default(PUBLISHING)
  createdAt      DateTime                 @default(now())
  completedAt    DateTime?

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  watermarkJob WatermarkJob @relation(fields: [watermarkJobId], references: [id], onDelete: Restrict)

  @@index([shopId, productId, status])
  @@index([shopId, shopifyMediaId])
  @@index([watermarkJobId, createdAt])
  @@map("publication_attempts")
}

model PublishedMedia {
  id               String   @id @db.VarChar(36)
  shopId           String   @db.VarChar(30)
  watermarkJobId   String   @unique @db.VarChar(36)
  shopifyProductId String   @db.VarChar(255)
  shopifyMediaId   String   @db.VarChar(255)
  imageUrl         String?  @db.Text
  createdAt        DateTime @default(now())

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  watermarkJob WatermarkJob @relation(fields: [watermarkJobId], references: [id], onDelete: Restrict)

  @@unique([shopId, shopifyMediaId])
  @@index([shopId, createdAt])
  @@index([shopId, shopifyProductId])
  @@map("published_media")
}

model WatermarkTemplate {
  id        String   @id @default(cuid()) @db.VarChar(30)
  shopId    String   @db.VarChar(30)
  name      String   @db.VarChar(255)
  config    String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("watermark_templates")
}
