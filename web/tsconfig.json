{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true
  },
  "include": [
  "index.ts",
  "worker.ts",
  "scripts/**/*.ts",
  "src/**/*.ts",
  "src/**/*.js"
]
}
